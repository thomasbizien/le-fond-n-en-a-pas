<script>
'use strict';
const $=id=>document.getElementById(id),clone=x=>JSON.parse(JSON.stringify(x));
const defaults=JSON.parse($('reel-config').textContent),storeKey='thomas-reel-v02-editor';
let config=clone(defaults),selected='ellipse',time=0,playing=false,raf=0,last=0;
const files=new Map(),nodes=new Map();let toastTimer;
function toast(message){$('toast').textContent=message;$('toast').style.display='block';clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').style.display='none',4500)}
function valid(raw){if(!raw||raw.version!==1||!Array.isArray(raw.frames)||raw.frames.length>20)throw Error('Réglages non reconnus (20 cadres maximum).');const c=clone(raw);c.title=String(c.title||'').slice(0,80);c.signature=String(c.signature||'').slice(0,80);c.tempo=117;c.duration=131.282041;const ids=new Set();c.frames=c.frames.map((f,i)=>{f.id=String(f.id||'frame'+i);if(ids.has(f.id))throw Error('Identifiant de cadre en double');ids.add(f.id);f.name=String(f.name||'Cadre').slice(0,50);f.text=String(f.text||'').slice(0,4000);f.src=String(f.src||'');if(f.src&&!/^(assets\/|data:(image|video)\/|https?:\/\/)/i.test(f.src))throw Error('Adresse du média non reconnue');f.kind=['text','image','video'].includes(f.kind)?f.kind:'text';f.mode=['always','hidden','interval','alternating'].includes(f.mode)?f.mode:'always';f.fit=f.fit==='cover'?'cover':'contain';['x','y','w','h','start','end','beats'].forEach(k=>{f[k]=Number(f[k]);if(!Number.isFinite(f[k]))throw Error('Valeur invalide : '+k)});f.beats=Math.max(1,Math.min(256,Math.round(f.beats)));f.start=Math.max(0,Math.min(c.duration,f.start));f.end=Math.max(f.start,Math.min(c.duration,f.end));f.firstVisible=!!f.firstVisible;bounds(f);return f});return c}
function bounds(f){f.w=Math.max(1,Math.min(100,f.w));f.h=Math.max(1,Math.min(100,f.h));f.x=Math.max(0,Math.min(100-f.w,f.x));f.y=Math.max(0,Math.min(100-f.h,f.y))}
try{const stored=localStorage.getItem(storeKey);if(stored)config=valid(JSON.parse(stored))}catch(e){toast('Les réglages locaux n’ont pas été chargés.')}
function frame(){return config.frames.find(f=>f.id===selected)}
function visible(f,t){if(f.mode==='hidden')return false;if(f.mode==='interval')return t>=f.start&&t<f.end;if(f.mode==='alternating'){const first=Math.floor(t/(f.beats*60/config.tempo))%2===0;return first===f.firstVisible}return true}
function format(t){return String(Math.floor(t/60)).padStart(2,'0')+':'+String(Math.floor(t%60)).padStart(2,'0')}
function position(el,f){Object.assign(el.style,{left:f.x+'%',top:f.y+'%',width:f.w+'%',height:f.h+'%'})}
function select(id){selected=id;for(const [key,n]of nodes){n.el.classList.toggle('selected',key===id);n.outline.classList.toggle('selected',key===id)}$('frameSelect').value=id;panel()}
function rebuild(){for(const n of nodes.values()){n.media?.pause?.();n.el.remove();n.outline.remove()}nodes.clear();$('stageTitle').textContent=config.title;$('stageSignature').textContent=config.signature;$('titleInput').value=config.title;$('signatureInput').value=config.signature;$('frameSelect').replaceChildren();config.frames.forEach((f,i)=>{const opt=document.createElement('option');opt.value=f.id;opt.textContent=f.name;$('frameSelect').append(opt);const el=document.createElement('div');el.className='frame';el.dataset.frameId=f.id;el.style.zIndex=String(i+1);const content=document.createElement('div');content.className='frame-content';if(f.id==='mediaA')content.style.background='#e3ded3';let media=null;if(f.src&&f.kind!=='text'){media=document.createElement(f.kind==='video'?'video':'img');media.src=f.src;media.style.objectFit=f.fit;if(f.kind==='video'){media.playsInline=true;media.preload='auto';media.muted=f.id!=='ellipse';media.addEventListener('error',()=>{$('mediaStatus').textContent='Impossible de lire « '+f.name+' ». Importe un fichier compatible.'});media.addEventListener('loadedmetadata',()=>{syncOne(media,true);if(playing&&visible(f,time))media.play().catch(()=>{})})}else media.alt=f.name;content.append(media)}else{const txt=document.createElement('div');txt.className='frame-text';txt.textContent=f.text;content.append(txt)}const handle=document.createElement('button');handle.className='handle';handle.textContent='↔ '+f.name;handle.setAttribute('aria-label','Déplacer '+f.name);handle.addEventListener('pointerdown',e=>startDrag(e,f,el));handle.addEventListener('keydown',e=>{if(!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(e.key))return;e.preventDefault();select(f.id);const delta=e.shiftKey?5:1;f.x+=e.key==='ArrowLeft'?-delta:e.key==='ArrowRight'?delta:0;f.y+=e.key==='ArrowUp'?-delta:e.key==='ArrowDown'?delta:0;bounds(f);layout(f);panel()});el.append(content,handle);el.addEventListener('pointerdown',()=>select(f.id));const outline=document.createElement('div');outline.className='outline';outline.dataset.outlineId=f.id;$('stage').append(el,outline);nodes.set(f.id,{el,outline,media});layout(f)});if(!frame())selected=config.frames[0]?.id||'';select(selected);update()}
function layout(f){const n=nodes.get(f.id);position(n.el,f);position(n.outline,f)}
function startDrag(e,f,el){e.preventDefault();select(f.id);const box=$('stage').getBoundingClientRect(),startX=e.clientX,startY=e.clientY,fx=f.x,fy=f.y;const handle=e.currentTarget;handle.setPointerCapture(e.pointerId);const move=event=>{f.x=fx+(event.clientX-startX)/box.width*100;f.y=fy+(event.clientY-startY)/box.height*100;bounds(f);layout(f);panel()};const end=()=>{handle.removeEventListener('pointermove',move);handle.removeEventListener('pointerup',end);handle.removeEventListener('pointercancel',end)};handle.addEventListener('pointermove',move);handle.addEventListener('pointerup',end);handle.addEventListener('pointercancel',end)}
function panel(){const f=frame();const disabled=!f;for(const id of ['nameInput','mode','startInput','endInput','beatsInput','firstVisible','xInput','yInput','wInput','hInput','textInput','fileInput','fit','removeMedia','delete'])$(id).disabled=disabled;if(!f)return;$('nameInput').value=f.name;$('mode').value=f.mode;$('startInput').value=f.start;$('endInput').value=f.end;$('beatsInput').value=f.beats;$('firstVisible').checked=f.firstVisible;['x','y','w','h'].forEach(k=>$(k+'Input').value=Number(f[k].toFixed(2)));$('textInput').value=f.text;$('fit').value=f.fit;$('intervalControls').hidden=f.mode!=='interval';$('alternateControls').hidden=f.mode!=='alternating';$('fileInput').value=''}
function syncOne(media,force=false){if(!media||media.tagName!=='VIDEO'||!Number.isFinite(media.duration)||!media.duration)return;const target=Math.min(time,Math.max(0,media.duration-.01));if(force||Math.abs(media.currentTime-target)>.35)media.currentTime=target}
function update(force=false){$('counter').textContent=format(time);$('clock').textContent=format(time);$('timeline').value=time;for(const f of config.frames){const n=nodes.get(f.id),show=visible(f,time);const was=n.el.style.visibility!=='hidden';n.el.style.visibility=n.outline.style.visibility=show?'visible':'hidden';if(n.media?.tagName==='VIDEO'){syncOne(n.media,force);if(playing&&show&&n.media.paused&&time<n.media.duration)n.media.play().catch(()=>{if(f.id==='ellipse')$('mediaStatus').textContent='Clique sur Lire pour activer la bande-son.'});if((!playing||!show)&&!n.media.paused)n.media.pause();if(show&&!was)syncOne(n.media,true)}}}
function pause(){playing=false;cancelAnimationFrame(raf);$('play').textContent='Lire';update()}
function tick(now){if(!playing)return;time=Math.min(config.duration,time+(now-last)/1000);last=now;update();if(time>=config.duration){pause();return}raf=requestAnimationFrame(tick)}
$('play').onclick=()=>{if(playing)return pause();if(time>=config.duration)time=0;playing=true;last=performance.now();$('play').textContent='Pause';update(true);raf=requestAnimationFrame(tick)};
$('timeline').oninput=()=>{time=Number($('timeline').value);update(true)};
$('frameSelect').onchange=()=>select($('frameSelect').value);
for(const key of ['x','y','w','h'])$(key+'Input').oninput=()=>{const f=frame(),value=Number($(key+'Input').value);if(!f||!Number.isFinite(value))return;f[key]=value;bounds(f);layout(f)};
$('titleInput').oninput=()=>{config.title=$('titleInput').value;$('stageTitle').textContent=config.title};$('signatureInput').oninput=()=>{config.signature=$('signatureInput').value;$('stageSignature').textContent=config.signature};
$('nameInput').onchange=()=>{frame().name=$('nameInput').value||'Cadre';rebuild()};$('mode').onchange=()=>{frame().mode=$('mode').value;panel();update()};
for(const key of ['start','end','beats'])$(key+'Input').onchange=()=>{const f=frame();f[key]=Number($(key+'Input').value);f.start=Math.max(0,Math.min(config.duration,f.start));f.end=Math.max(f.start,Math.min(config.duration,f.end));f.beats=Math.max(1,Math.min(256,Math.round(f.beats)||16));panel();update()};$('firstVisible').onchange=()=>{frame().firstVisible=$('firstVisible').checked;update()};
$('textInput').oninput=()=>{const f=frame();f.text=$('textInput').value;const txt=nodes.get(f.id).el.querySelector('.frame-text');if(txt)txt.textContent=f.text};$('fit').onchange=()=>{frame().fit=$('fit').value;const m=nodes.get(selected).media;if(m)m.style.objectFit=frame().fit};
$('add').onclick=()=>{if(config.frames.length>=20)return toast('20 cadres maximum.');const id='frame-'+Date.now();config.frames.push({id,name:'Nouvelle frame',x:20,y:60,w:45,h:18,text:'NOUVEAU MÉDIA',src:'',kind:'text',mode:'always',start:0,end:config.duration,beats:16,firstVisible:true,fit:'contain'});selected=id;rebuild()};
$('delete').onclick=()=>{const f=frame();if(!f)return;config.frames=config.frames.filter(x=>x.id!==f.id);files.delete(f.id);rebuild()};
$('removeMedia').onclick=()=>{const f=frame();if(f.src.startsWith('blob:'))URL.revokeObjectURL(f.src);files.delete(f.id);f.src='';f.kind='text';rebuild()};
$('fileInput').onchange=()=>{const file=$('fileInput').files[0],f=frame();if(!file||!f)return;if(!/^(image|video)\//.test(file.type))return toast('Choisis une image ou une vidéo.');if(file.size>150*1024*1024)return toast('Choisis un fichier de moins de 150 Mo.');if(f.src.startsWith('blob:'))URL.revokeObjectURL(f.src);files.set(f.id,file);f.src=URL.createObjectURL(file);f.kind=file.type.startsWith('image/')?'image':'video';$('mediaStatus').textContent='';rebuild()};
$('guides').onchange=()=>$('stage').classList.toggle('clean',!$('guides').checked);
$('present').onclick=()=>{document.body.classList.add('presentation');$('stage').classList.add('clean')};$('exit').onclick=()=>{document.body.classList.remove('presentation');$('stage').classList.toggle('clean',!$('guides').checked)};document.addEventListener('keydown',e=>{if(e.key==='Escape')$('exit').click()});
function download(name,content,type){const url=URL.createObjectURL(new Blob([content],{type})),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}
async function portable(){const c=clone(config);for(const f of c.frames){if(files.has(f.id))f.src=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=reject;reader.readAsDataURL(files.get(f.id))})}return c}
$('save').onclick=async()=>{try{localStorage.setItem(storeKey,JSON.stringify(await portable()));toast('Réglages enregistrés dans ce navigateur.')}catch(e){toast('Mémoire locale pleine : télécharge l’index ou les réglages.')}};
$('exportConfig').onclick=async()=>{try{download('reel-reglages.json',JSON.stringify(await portable(),null,2),'application/json')}catch(e){toast('Export impossible. Réessaie.')}};
$('importButton').onclick=()=>$('importConfig').click();$('importConfig').onchange=async()=>{try{const file=$('importConfig').files[0];if(!file)return;const next=valid(JSON.parse(await file.text()));pause();config=next;files.clear();selected='ellipse';time=0;rebuild();toast('Réglages importés.')}catch(e){toast(e.message||'Impossible de lire ces réglages.')}finally{$('importConfig').value=''}};
$('export').onclick=async()=>{try{const c=await portable(),doc=document.documentElement.cloneNode(true);doc.querySelector('#reel-config').textContent=JSON.stringify(c).replace(/</g,'\\u003c');doc.querySelector('body').classList.remove('presentation');doc.querySelector('#stage').classList.remove('clean');doc.querySelector('#guides').setAttribute('checked','');doc.querySelector('#stage').replaceChildren();doc.querySelector('#stage').innerHTML='<div class="stage-title" id="stageTitle"></div><div class="counter" id="counter">00:00</div><div class="signature" id="stageSignature"></div>';doc.querySelector('#frameSelect').replaceChildren();doc.querySelector('#toast').style.display='none';doc.querySelector('#mediaStatus').textContent='';download('index.html','<!doctype html>\n'+doc.outerHTML,'text/html');toast('Index téléchargé. Garde le dossier assets à côté.')}catch(e){toast('Export impossible. Réessaie.')}};
$('reset').onclick=()=>{pause();config=clone(defaults);files.clear();selected='ellipse';time=0;try{localStorage.removeItem(storeKey)}catch(e){}rebuild();toast('Modèle restauré.')};
rebuild();
</script></body></html>
